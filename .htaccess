# Padang Records · cache strategy

<IfModule mod_headers.c>
  # HTML: never cached — always fetch fresh (fixes the cron-deploy lag issue)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # CSS/JS/JSON: short cache, must revalidate
  <FilesMatch "\.(js|json|css)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  # Images/fonts: 30-day cache, immutable
  <FilesMatch "\.(svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  # Security niceties
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Force UTF-8
AddDefaultCharset UTF-8

# Gzip compress text-based files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
